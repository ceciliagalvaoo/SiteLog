# Copy to .env (git-ignored) and fill in the empty values.
# Read by docker compose and by the Spring `dev` profile. Never commit .env.

# Local PostgreSQL (docker-compose.yml, service `db`)
POSTGRES_DB=sitelog
POSTGRES_USER=sitelog
POSTGRES_PASSWORD=
DB_PORT=5432

# Application container (docker-compose.yml, service `app`, profile prod).
# Its DB_URL / DB_USERNAME / DB_PASSWORD are built from the POSTGRES_* values above.
# Host port for http://localhost:<APP_PORT> (stop `./mvnw spring-boot:run` first if both use 8080).
APP_PORT=8080
# HikariCP maximum pool size (optional, default 5); uncomment to change it.
# DB_POOL_SIZE=5

# ---------------------------------------------------------------------------
# Production (Render > Environment). Set these in the Render dashboard, NOT here.
# Listed only so every variable the prod profile reads is documented in one place.
#   SPRING_PROFILES_ACTIVE=prod
#   DB_URL=jdbc:postgresql://<supabase-session-pooler-host>:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<supabase database password>
#   DB_POOL_SIZE=5
#   PORT is set by Render itself.
